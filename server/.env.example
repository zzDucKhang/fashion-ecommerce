# App
NODE_ENV=dev
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/fashion_ecommerce?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT - thay bằng chuỗi bí mật đủ dài, không dùng giá trị mẫu ở production
ACCESS_TOKEN_SECRET="change-this-access-secret"
ACCESS_TOKEN_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET="change-this-refresh-secret"
REFRESH_TOKEN_EXPIRES_IN="1d"

# Payment
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT_NUMBER
SEPAY_BANK_CODE=YOUR_BANK_CODE
SEPAY_WEBHOOK_SECRET=super_secret

# S3 (optional)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=


# Gmail
MAIL_USER=your_email@gmail.com
MAIL_PASS=
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=email-ban-dung-dang-ky-brevo@gmail.com
BREVO_SENDER_NAME="Thảo Trang Fashion"

