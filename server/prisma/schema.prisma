generator client {
  provider = "prisma-client-js"
}

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL_CLOUD")
//   directUrl = env("DIRECT_URL_CLOUD")
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
  LOGIN
  DISABLE_2FA
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PointTransType {
  EARN
  REDEEM
  REFUND
  EXPIRE
}

enum ChatStatus {
  OPEN
  WAITING
  CLOSED
}

// ==========================================
// 2. IDENTITY & ACCESS MANAGEMENT
// ==========================================

model User {
  id           Int        @id @default(autoincrement())
  fullName     String     @db.VarChar(255)
  email        String     @unique @db.VarChar(255)
  phoneNumber  String     @db.VarChar(50)
  passwordHash String     @db.VarChar(255)
  avatarUrl    String?    @db.VarChar(1000)

  // TỐI ƯU DB: Cache số dư điểm thưởng để truy vấn O(1)
  rewardPoints Int        @default(0)
  status       UserStatus @default(ACTIVE)

  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  shippingAddresses ShippingAddress[]
  deviceSessions    DeviceSession[]
  cart              Cart?
  orders            Order[]
  pointTransactions PointTransaction[]
  reviews           ProductReview[]
  chats             Chat[]
  messages          Message[]

  // Audit trail & Soft delete
  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([email])
}

model VerificationCode {
  id        Int                  @id @default(autoincrement())
  email     String               @db.VarChar(255)
  code      String               @db.VarChar(50)
  type      VerificationCodeType
  isUsed    Boolean              @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([expiresAt])
}

model Role {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(100)
  name     String  @db.VarChar(255)
  isActive Boolean @default(true)

  users       User[]
  permissions Permission[] @relation("RolePermissions")

  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(150)
  module      String  @db.VarChar(100)
  description String? @db.Text

  roles Role[] @relation("RolePermissions")

  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model ShippingAddress {
  id            Int     @id @default(autoincrement())
  userId        Int
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiverName  String  @db.VarChar(255)
  phoneNumber   String  @db.VarChar(50)
  province      String  @db.VarChar(150)
  district      String  @db.VarChar(150)
  ward          String  @db.VarChar(150)
  detailAddress String  @db.VarChar(500)
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DeviceSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @db.VarChar(1000)
  ipAddress    String   @db.VarChar(100)
  isActive     Boolean  @default(true)
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// 3. PRODUCT CATALOG
// ==========================================

model Category {
  id          Int        @id @default(autoincrement())
  defaultName String     @db.VarChar(255)
  iconUrl     String?    @db.VarChar(1000)
  isVisible   Boolean    @default(true)
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")

  products    Product[]

  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([parentId])
}

model Brand {
  id          Int     @id @default(autoincrement())
  defaultName String  @db.VarChar(255)
  logoUrl     String? @db.VarChar(1000)

  products    Product[]

  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(100)
  products Product[] @relation("ProductTags")

  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model Product {
  id           Int           @id @default(autoincrement())
  defaultName  String        @db.VarChar(255)
  thumbnailUrl String?       @db.VarChar(1000)
  status       ProductStatus @default(DRAFT)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  brandId    Int?
  brand      Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  images       ProductImage[]
  variants     ProductVariant[]
  tags         Tag[]            @relation("ProductTags")
  reviews      ProductReview[]

  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model ProductImage {
  id           Int     @id @default(autoincrement())
  productId    Int
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String  @db.VarChar(1000)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id            Int     @id @default(autoincrement())
  productId     Int
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String  @unique @db.VarChar(150)

  // TỐI ƯU DB: Lưu tồn kho để query O(1)
  stockQuantity Int     @default(0)

  originalPrice Decimal @db.Decimal(12, 2)
  sellingPrice  Decimal @db.Decimal(12, 2)
  weightGram    Int     @default(0)
  imageUrl      String? @db.VarChar(1000)

  // CHUẨN CLASS DIAGRAM: Thuộc tính phẳng
  variant       String? @db.VarChar(100)
  variantValue  String? @db.VarChar(150)

  flashSaleItems  FlashSaleItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
  @@index([deletedAt])
}

// ==========================================
// 4. INVENTORY & FLASH SALE
// ==========================================

model FlashSaleCampaign {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  bannerUrl String?  @db.VarChar(1000)
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)

  items FlashSaleItem[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startTime, endTime])
  @@index([isActive])
}

model FlashSaleItem {
  id             Int               @id @default(autoincrement())
  campaignId     Int
  campaign       FlashSaleCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variantId      Int
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  flashSalePrice Decimal           @db.Decimal(12, 2)
  promoQuantity  Int

  // TỐI ƯU DB: Counter chống Oversell
  soldQuantity   Int               @default(0)

  @@unique([campaignId, variantId])
  @@index([campaignId])
}

// ==========================================
// 5. CART & ORDER PROCESSING
// ==========================================

model Cart {
  id        Int     @id @default(autoincrement())
  userId    Int?    @unique
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? @unique @db.VarChar(255)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        Int            @id @default(autoincrement())
  quantity  Int            @default(1)

  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Khôi phục
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id        Int    @id @default(autoincrement())
  orderCode String @unique @db.VarChar(100)
  userId    Int
  user      User   @relation(fields: [userId], references: [id], onUpdate: NoAction)

  // CHUẨN CLASS DIAGRAM: Snapshot địa chỉ thành 1 chuỗi
  shippingAddress  String @db.VarChar(500)

  // TỐI ƯU DB: Các trường tính toán (Materialized Fields)
  subTotal         Decimal @db.Decimal(12, 2)
  shippingFee      Decimal @db.Decimal(12, 2)
  shippingMethod   String  @default("STANDARD") @db.VarChar(50)
  shippingDiscount Decimal @default(0) @db.Decimal(12, 2)
  voucherCode      String? @db.VarChar(100)
  voucherDiscount  Decimal @default(0) @db.Decimal(12, 2)
  pointUsed        Int     @default(0)
  pointDiscount    Decimal @default(0) @db.Decimal(12, 2)
  pointEarned      Int     @default(0)
  totalAmount      Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING_PAYMENT)
  customerNote  String?       @db.Text
  orderDate     DateTime      @default(now())

  orderItems          OrderItem[]
  shipment            Shipment?
  paymentTransactions PaymentTransaction[]
  pointTransactions   PointTransaction[]
  reviews             ProductReview[]

  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status, deletedAt])
  @@index([deletedAt])
}

model OrderItem {
  id              Int             @id @default(autoincrement())
  productName     String          @db.VarChar(255)
  skuCode         String          @db.VarChar(150)
  variantValue    String          @db.VarChar(255)
  productImageUrl String?         @db.VarChar(1000)
  unitPrice       Decimal         @db.Decimal(12, 2)
  quantity        Int

  orderId         Int
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       Int?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  returnRequests  ReturnRequest[]

  // Khôi phục
  deletedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

// ==========================================
// 6. FULFILLMENT & PAYMENT
// ==========================================

model Shipment {
  id                Int            @id @default(autoincrement())
  carrier           String         @db.VarChar(100)
  trackingCode      String         @unique @db.VarChar(150)
  actualShippingFee Decimal        @db.Decimal(12, 2)
  status            ShipmentStatus @default(PENDING)
  estimatedDelivery DateTime?

  orderId           Int            @unique
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Khôi phục
  deletedAt         DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model ReturnRequest {
  id          Int          @id @default(autoincrement())
  quantity    Int
  reason      String       @db.VarChar(255)
  description String?      @db.Text
  status      ReturnStatus @default(PENDING)

  orderItemId Int
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  medias      ReturnMedia[]

  // Khôi phục
  deletedAt   DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ReturnMedia {
  id              Int           @id @default(autoincrement())
  returnRequestId Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  mediaUrl        String        @db.VarChar(1000)
  mediaType       String        @db.VarChar(50)
}

model PaymentTransaction {
  id              Int           @id @default(autoincrement())
  provider        String        @db.VarChar(100)
  providerTransId String?       @unique @db.VarChar(255)
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)

  orderId         Int           @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Khôi phục
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// ==========================================
// 7. LOYALTY, ENGAGE & REAL-TIME
// ==========================================

model PointTransaction {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         Int?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pointChange     Int
  currentPoint    Int
  transactionType PointTransType
  description     String         @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Voucher {
  id              Int          @id @default(autoincrement())
  code            String       @unique @db.VarChar(100)
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(12, 2)
  minOrderValue   Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscountAmt  Decimal?     @db.Decimal(12, 2)
  totalUsageLimit Int          @default(0)

  // TỐI ƯU DB: Counter chống Oversell
  usedCount       Int          @default(0)

  userUsageLimit  Int          @default(1)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean      @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([code])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
}

model ProductReview {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  rating      Int     @db.SmallInt
  content     String  @db.Text
  shopReply   String? @db.Text
  isHidden    Boolean @default(false)

  medias ReviewMedia[]
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId])
  @@index([userId])
}

model ReviewMedia {
  id        Int           @id @default(autoincrement())
  reviewId  Int
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaUrl  String        @db.VarChar(1000)
  mediaType String        @db.VarChar(50)
}

// Tạo Bảng Chat theo Composition pattern với Message
model Chat {
  id        Int        @id @default(autoincrement())
  status    ChatStatus @default(OPEN)
  startedAt DateTime   @default(now())
  endedAt   DateTime?

  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  Message[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
}

model Message {
  id            Int       @id @default(autoincrement())
  content       String    @db.Text
  sendDate      DateTime  @default(now())
  isRead        Boolean   @default(false)

  chatId        Int
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Liên kết người gửi
  senderId      Int
  sender        User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([chatId])
  @@index([senderId])
}
